// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Player {
  PLAYER1
  PLAYER2
}

enum EncounterStatus {
  CAUGHT
  KILLED
  FLED
}

enum LinkStatus {
  ALIVE
  DEAD
}

// SOULLINK = two players catching in parallel (original mode). CLASSIC =
// solo play - only ever one Encounter (Player.PLAYER1) per route. Fixed at
// Run creation, never changed afterwards.
enum RunMode {
  SOULLINK
  CLASSIC
}

// A single playthrough. All Encounters/SoulLinks/LevelCapProgress are scoped
// to one Run so multiple playthroughs can coexist in the same database.
model Run {
  id               Int                @id @default(autoincrement())
  name             String
  mode             RunMode            @default(SOULLINK)
  // Which game data pack (data/games/<gameId>/) this run plays - fixed at
  // creation. Unknown ids fall back to "firered" at read time in data.ts.
  gameId           String             @default("firered")
  // Raw markdown shown on the Rules tab. Copied from the most recent run on
  // creation (falling back to the built-in default ruleset in code).
  rulesMarkdown    String             @default("")
  // Per-run rule toggles as a JSON object (SQLite has no Json scalar in
  // Prisma). Parsed/defaulted by src/lib/runSettings.ts - missing keys fall
  // back to defaults, so '{}' is always valid. Copied from the most recent
  // run on creation, like rulesMarkdown.
  settingsJson     String             @default("{}")
  createdAt        DateTime           @default(now())
  soulLinks        SoulLink[]
  encounters       Encounter[]
  levelCapProgress LevelCapProgress[]
}

// One SoulLink per (run, route), created once at least one player has a
// CAUGHT encounter there. Holds 1 encounter (single catch, e.g. static) or 2
// (both players caught) — "Tot" cascades LinkStatus to all its encounters.
model SoulLink {
  id         Int         @id @default(autoincrement())
  runId      Int
  routeId    Int
  status     LinkStatus  @default(ALIVE)
  // 0-5 when this link occupies a slot of the run's 6-slot team, else null.
  // Unique per run so a slot holds at most one link (and a link one slot).
  teamPosition Int?
  // In SoulLink, which player's Pokémon fainted and killed the link (both die
  // together, but this records who lost theirs). Null = unknown / Classic.
  deathPlayer  Player?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  run        Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  encounters Encounter[]

  @@unique([runId, routeId])
  @@unique([runId, teamPosition])
}

// One row per player per route encounter attempt. familyId is denormalized
// from pokemon.json at write time so the Species Clause check is a single
// indexed query instead of joining against the static JSON on every check.
//
// pokemonId is what was actually caught on the route and never changes after
// the fact - the Tracker tab always shows this. currentPokemonId starts out
// equal to it but is the only field evolve/revert touch, so evolving in the
// Links tab never affects what the Tracker tab displays.
model Encounter {
  id               Int             @id @default(autoincrement())
  runId            Int
  routeId          Int
  player           Player
  pokemonId        Int
  currentPokemonId Int
  familyId         Int
  // Optional user-given nickname (rendered when the run's `nicknames` rule is
  // on; the data is kept either way so toggling the rule is lossless).
  nickname         String?
  status           EncounterStatus @default(CAUGHT)
  isStatic         Boolean         @default(false)
  soulLinkId       Int?
  run              Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  soulLink         SoulLink?       @relation(fields: [soulLinkId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([runId, routeId, player])
  @@index([runId, familyId])
}

// Per-run "have we beaten this trainer yet" toggle for a levelcaps.json entry.
model LevelCapProgress {
  id         Int      @id @default(autoincrement())
  runId      Int
  levelCapId Int
  defeated   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, levelCapId])
}
