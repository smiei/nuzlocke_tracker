// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Player {
  PLAYER1
  PLAYER2
}

enum EncounterStatus {
  CAUGHT
  KILLED
  FLED
}

enum LinkStatus {
  ALIVE
  DEAD
}

// SOULLINK = two players catching in parallel (original mode). CLASSIC =
// solo play - only ever one Encounter (Player.PLAYER1) per route. Fixed at
// Run creation, never changed afterwards.
enum RunMode {
  SOULLINK
  CLASSIC
}

// A single playthrough. All Encounters/SoulLinks/LevelCapProgress are scoped
// to one Run so multiple playthroughs can coexist in the same database.
model Run {
  id               Int                @id @default(autoincrement())
  name             String
  mode             RunMode            @default(SOULLINK)
  // Which game data pack (data/games/<gameId>/) this run plays - fixed at
  // creation. Unknown ids fall back to "firered" at read time in data.ts.
  gameId           String             @default("firered")
  // Raw markdown shown on the Rules tab. Copied from the most recent run on
  // creation (falling back to the built-in default ruleset in code).
  rulesMarkdown    String             @default("")
  // Per-run rule toggles as a JSON object (SQLite has no Json scalar in
  // Prisma). Parsed/defaulted by src/lib/runSettings.ts - missing keys fall
  // back to defaults, so '{}' is always valid. Copied from the most recent
  // run on creation, like rulesMarkdown.
  settingsJson     String             @default("{}")
  createdAt        DateTime           @default(now())
  soulLinks        SoulLink[]
  encounters       Encounter[]
  levelCapProgress LevelCapProgress[]
  customRoutes     CustomRoute[]
  routeEntries     RouteEntry[]
}

// One SoulLink per (run, route), created once at least one player has a
// CAUGHT encounter there. Holds 1 encounter (single catch, e.g. static) or 2
// (both players caught) — "Tot" cascades LinkStatus to all its encounters.
model SoulLink {
  id         Int         @id @default(autoincrement())
  runId      Int
  routeId    Int
  status     LinkStatus  @default(ALIVE)
  // 0-5 when this link occupies a slot of the run's 6-slot team, else null.
  // Unique per run so a slot holds at most one link (and a link one slot).
  teamPosition Int?
  // In SoulLink, which player's Pokémon fainted and killed the link (both die
  // together, but this records who lost theirs). Null = unknown / Classic.
  deathPlayer  Player?
  // Optional free-text cause of death (e.g. the opponent or move that did it),
  // shown in the Memorial. Null = not recorded.
  deathCause   String?
  // WHERE in the run it died: the last Journey milestone defeated at that
  // moment (a levelcaps.json id, or null when none was defeated yet). Lets
  // the Memorial read in the order things actually happened rather than by
  // route. Not a foreign key - level-cap ids live in the game pack, like
  // routeId.
  deathLevelCapId Int?
  // When it was marked dead. Doubles as "was a death point ever recorded?":
  // links that died before this was tracked have null here and sort ahead of
  // everything else in the Memorial until edited.
  diedAt       DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  run        Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  encounters Encounter[]

  @@unique([runId, routeId])
  @@unique([runId, teamPosition])
}

// One row per player per route encounter attempt. familyId is denormalized
// from pokemon.json at write time so the Species Clause check is a single
// indexed query instead of joining against the static JSON on every check.
//
// pokemonId is what was actually caught on the route and never changes after
// the fact - the Tracker tab always shows this. currentPokemonId starts out
// equal to it but is the only field evolve/revert touch, so evolving in the
// Links tab never affects what the Tracker tab displays.
model Encounter {
  id               Int             @id @default(autoincrement())
  runId            Int
  routeId          Int
  player           Player
  pokemonId        Int
  currentPokemonId Int
  familyId         Int
  // Optional user-given nickname (rendered when the run's `nicknames` rule is
  // on; the data is kept either way so toggling the rule is lossless).
  nickname         String?
  status           EncounterStatus @default(CAUGHT)
  isStatic         Boolean         @default(false)
  // Shiny Clause: a shiny catch is exempt from the Species Clause - its own
  // warning is suppressed and it never locks the family for other encounters.
  shiny            Boolean         @default(false)
  soulLinkId       Int?
  run              Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  soulLink         SoulLink?       @relation(fields: [soulLinkId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([runId, routeId, player])
  @@index([runId, familyId])
}

// Per-run "have we beaten this trainer yet" toggle for a levelcaps.json entry.
model LevelCapProgress {
  id         Int      @id @default(autoincrement())
  runId      Int
  levelCapId Int
  defeated   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, levelCapId])
}

// A saved ruleset: the boolean rule toggles plus the house-rules markdown,
// under a name. Deliberately NOT scoped to a Run - the point is to carry a
// ruleset from one playthrough to the next, so every run's Rules tab offers
// the same list.
//
// settingsJson holds the toggles only. Run.settingsJson also carries
// playerNames, which is the one part of a run's settings that is genuinely
// about *that* run; a preset that renamed the players every time it was
// applied would be a trap, so presetSettingsJson() strips it on the way in
// and applyRulePreset leaves the run's names alone on the way out.
//
// `name` is unique, which is what makes "save under an existing name" an
// overwrite rather than a second entry with the same label.
model RulePreset {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  settingsJson  String   @default("{}")
  rulesMarkdown String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A location the user added by hand, for one run only. Game packs cannot
// cover every group's house rules - somebody declares three more statics than
// data/games/<gameId>/routes.json knows about - and editing the pack would
// change it for every run that plays that game.
//
// `routeId` is what the merged route list exposes this under, and it is
// ALWAYS NEGATIVE: pack ids are positive and must never be renumbered or
// reused, so the two ranges can never collide. It is assigned per run
// (-1, -2, ...) rather than derived from `id`, which is what lets a backup
// restore it verbatim - every Encounter and SoulLink referring to it keeps
// working without any id remapping on import.
//
// `afterRouteId` is the insert point in display order (the id of the route
// this one follows, null = at the very top). Storing an anchor rather than an
// index means the pack's own list can still be reordered underneath without
// invalidating it.
model CustomRoute {
  id           Int      @id @default(autoincrement())
  runId        Int
  routeId      Int
  // Single free-text name - unlike a pack route there is nothing to localize,
  // so getRoutesForRun fans it out to every language.
  name         String
  // "route" | "static", matching RouteType in data.ts. A plain String rather
  // than an enum: the values live in the JSON packs, not in the database.
  type         String   @default("route")
  afterRouteId Int?
  // A slot created by the free-team feature rather than a location the run
  // actually visits. It still needs to be a route - that is what carries an
  // Encounter and a SoulLink, and therefore a team position - but it must not
  // appear on the Encounter tab or count towards the encounter progress bar.
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, routeId])
}

// Debug aid: when a route was FIRST entered in this run, append-only.
//
// Encounter.createdAt almost answers this already, but clearEncounter deletes
// the row, so fixing a typo would silently move that route to the end of the
// order - which is exactly the thing this table exists to get right. Written
// on every encounter save, unconditionally, so the data is already there
// whenever somebody switches the export on. The switch itself is per DEVICE
// (localStorage, see src/lib/useDebugMode.ts) and only controls whether the
// export UI is offered - it is not a run setting, so it never reaches this
// database and never syncs to the other player's phone.
model RouteEntry {
  id      Int      @id @default(autoincrement())
  runId   Int
  routeId Int
  // Backfilled from the earliest encounter on the route when the row is
  // created, so switching this feature on mid-run does not stamp every
  // existing route with today's date.
  seenAt  DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, routeId])
}
