# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files / secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma sqlite dev db (production db lives in the docker volume, not the repo)
/prisma/dev.db
/prisma/dev.db-journal

# pokemon sprites - downloaded via scripts/download-sprites.mjs, regenerable,
# not worth committing (386 binary files)
/public/pokemon-sprites/
/public/ball-sprites/

# gym badge icons - downloaded/cropped via scripts/download-badges.mjs from a
# third-party source, regenerable, same non-commercial-artwork policy
/public/badges/

# trainer sprites - copyrighted game artwork, user-provided (see
# public/trainers/README.txt); kept out of the repo for publication.
# Both the flat root and the per-game trainerSet subfolders.
/public/trainers/*.png
/public/trainers/**/*.png

# PWA app icons - OUR artwork, but still a build artefact: generated from
# src/app/icon.svg by scripts/generate-icons.mjs via npm's prebuild/predev
# hook. The global `*.png` rule above would already swallow these; this entry
# states the intent, because a committed icon here would be invisible to git
# while still working in a local Docker build - broken only on a clean clone.
/public/icons/

# Private branding override (see docker-entrypoint.sh): a personal icon.svg
# mounted into the container at runtime. Must never reach the repo or the
# published image - branding/icon.svg is the tracked default.
/branding-local/

# Claude Code local settings (machine-specific, never committed)
.claude/
CLAUDE.md
claude.md

# graphify knowledge graph output - regenerable from the sources via /graphify,
# machine-specific paths inside, and ~1.5 MB of generated HTML/JSON
/graphify-out/